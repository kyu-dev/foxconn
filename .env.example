# Agent model, "provider/model": ollama, openai, anthropic, xai
# e.g. ollama/qwen3.8:27b-mlx, openai/gpt-5 (ids: https://mastra.ai/models)
MOLTUS_MODEL=ollama/qwen3.8:27b-mlx

# ollama (from Docker: http://host.docker.internal:11434/api)
OLLAMA_BASE_URL=

# Cloud APIs: uncomment only what you use
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# XAI_API_KEY=

# classifier
TYPESAFE_AI_API_KEY=
