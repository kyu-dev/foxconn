# Model used by the agents: "provider/model"
# Providers: ollama, openai, anthropic, xai, claude-code, codex
# Examples: claude-code/sonnet, codex/gpt-6-astra, ollama/qwen3:8b (model ids: https://mastra.ai/models)
FOXCONN_MODEL=claude-code/sonnet

# claude-code: uses your Claude subscription.
# On the host, `claude` login is enough. In Docker, generate a token with `claude setup-token`.
# Do not set ANTHROPIC_API_KEY at the same time, or Claude Code bills the API key instead.
# CLAUDE_CODE_OAUTH_TOKEN=

# codex: uses `codex login` on the host; in Docker, set OPENAI_API_KEY below

# ollama: local server (from Docker: http://host.docker.internal:11434/api)
OLLAMA_BASE_URL=

# Cloud APIs (Mastra model router). Uncomment only what you use: empty values still count as set.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# XAI_API_KEY=

# Classifiers (bug triage): TypeSafe AI decision model "jev-latest".
# Not wired yet: required once the bug classifier runs in the workflow.
# TYPESAFE_AI_API_KEY=
