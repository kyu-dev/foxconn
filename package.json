{
  "name": "foxconn",
  "version": "1.0.0",
  "description": "Ai agent factory",
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "check": "pnpm lint && pnpm typecheck && pnpm test:unit",
    "prepare": "if [ -d .git ]; then git config core.hooksPath .githooks; fi"
  },
  "engines": {
    "node": ">=26"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.21.0",
  "type": "module",
  "dependencies": {
    "@mastra/core": "^1.85.0",
    "ai-sdk-provider-claude-code": "^4.4.1",
    "ai-sdk-provider-codex-cli": "^2.4.0",
    "ollama-ai-provider-v2": "^4.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.15.0",
    "mastra": "^1.40.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
